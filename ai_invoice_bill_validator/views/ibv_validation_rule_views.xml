<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ibv_validation_rule_tree" model="ir.ui.view">
        <field name="name">ibv.validation.rule.tree</field>
        <field name="model">ibv.validation.rule</field>
        <field name="arch" type="xml">
            <tree string="Validation Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="field_name"/>
                <field name="severity"/>
                <field name="violations_found"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_ibv_validation_rule_form" model="ir.ui.view">
        <field name="name">ibv.validation.rule.form</field>
        <field name="model">ibv.validation.rule</field>
        <field name="arch" type="xml">
            <form string="Validation Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Duplicate Invoice Detection"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rule_type"/>
                            <field name="field_name"/>
                            <field name="severity"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="violations_found"/>
                        </group>
                    </group>
                    <group string="Condition">
                        <field name="condition" nolabel="1" colspan="2" placeholder="Describe or define the condition this rule evaluates..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ibv_validation_rule" model="ir.actions.act_window">
        <field name="name">Validation Rules</field>
        <field name="res_model">ibv.validation.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new validation rule
            </p>
            <p>
                Validation rules define the checks applied to invoices and bills,
                such as amount matching, tax verification, and duplicate detection.
            </p>
        </field>
    </record>
</odoo>
